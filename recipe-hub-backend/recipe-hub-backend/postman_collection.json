              ],
              "path": [
                "api",
                "recipes",
                "9"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Zesty Lemon Rice\",\n  \"prepTime\": 30\n}"
            }
