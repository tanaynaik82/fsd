            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/recipes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Lemon Rice\",\n  \"instructions\": \"Cook rice, temper with spices, mix in lemon juice.\",\n  \"prepTime\": 25,\n  \"servings\": 2,\n  \"difficulty\": \"easy\",\n  \"categoryId\": 2,\n  \"ingredients\": [\n    {\n      \"ingredientId\": 13,\n      \"quantity\": 200,\n      \"unit\": \"g\"\n    },\n    {\n      \"ingredientId\": 15,\n      \"quantity\": 2\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "Update recipe (replaces ingredients if sent)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
