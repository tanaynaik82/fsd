    {
      "name": "Recipes",
      "item": [
        {
          "name": "List recipes (filtered)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes?category=2&maxTime=45&difficulty=easy&search=pasta&ingredient=tomato&sort=prepTime&order=ASC&page=1&limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "2"
                },
                {
                  "key": "maxTime",
                  "value": "45"
                },
                {
                  "key": "difficulty",
                  "value": "easy"
                },
                {
                  "key": "search",
                  "value": "pasta"
                },
                {
                  "key": "ingredient",
                  "value": "tomato"
                },
                {
                  "key": "sort",
                  "value": "prepTime"
                },
                {
                  "key": "order",
                  "value": "ASC"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            }
          }
        },
        {
          "name": "Get recipe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/recipes/3",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "recipes",
                "3"
              ]
            }
          }
        },
