                "6"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Snacks & Starters\",\n  \"description\": \"Quick bites\"\n}"
            }
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
